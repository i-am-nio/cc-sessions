{
  "name": "@i-am-nio/cc-sessions",
  "version": "1.0.1",
  "description": "Session bookmark manager for Claude Code CLI",
  "type": "module",
  "bin": {
    "cc-sessions": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ink": "^5.0.1",
    "react": "^18.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "claude-code",
    "claude",
    "sessions",
    "bookmarks",
    "cli",
    "productivity"
  ],
  "author": "i-am-nio",
  "license": "MIT",
  "preferGlobal": true
}
